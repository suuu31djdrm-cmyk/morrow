# Server-only settings. Do not use a service_role key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
AUTH_APP_ORIGIN=http://localhost:3000
# Enable only after each provider is configured in Supabase.
AUTH_GOOGLE_ENABLED=false
AUTH_LINE_ENABLED=false
AUTH_EMAIL_ENABLED=false
AUTH_SMS_ENABLED=false
# Public site key; keep the Turnstile secret in Supabase's CAPTCHA settings.
TURNSTILE_SITE_KEY=
# Explicitly opt in to local-only demo when Auth is unconfigured. Never used for cloud data.
ALLOW_LOCAL_DEMO=false
